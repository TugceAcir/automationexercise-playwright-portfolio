{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node", "@playwright/test"],
    "noEmit": true
  },
  "include": ["playwright.config.ts", "playwright.a11y.config.ts", "pages/**/*.ts", "fixtures/**/*.ts", "test-data/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "shared/**/*.ts"]
}
