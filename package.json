{
  "name": "automationexercise-playwright-portfolio",
  "version": "1.0.0",
  "description": "Senior-style Playwright TypeScript automation framework for Automation Exercise.",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "report": "playwright show-report",
    "business-report": "tsx scripts/business-reporter.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "keywords": [
    "playwright",
    "typescript",
    "test-automation",
    "portfolio",
    "qa"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "eslint": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest"
  }
}
