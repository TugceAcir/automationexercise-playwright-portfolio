{
  "name": "automationexercise-api-contract",
  "version": "1.0.0",
  "description": "Isolated, read-only API contract tests for the Automation Exercise public demo API. Separate from the UI suite's dependencies, reports and dashboard.",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "preflight": "tsx scripts/preflight.ts",
    "test:api": "playwright test",
    "summary": "tsx scripts/api-summary.ts",
    "coverage:counts": "tsx scripts/coverage-counts.ts",
    "coverage:check": "tsx scripts/coverage-counts.ts --check"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22 <23"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.1",
    "eslint": "10.10.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "zod": "4.6.5"
  }
}
